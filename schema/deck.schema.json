{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeckSchema",
  "description": "Single source of truth schema for Verified Course Material Studio decks",
  "type": "object",
  "required": ["deck_id", "topic", "level", "minutes", "stack", "slides", "exercises", "quiz", "cheat_sheet"],
  "properties": {
    "deck_id": {
      "type": "string",
      "description": "Unique stable identifier for the deck, e.g. d_001"
    },
    "topic": {
      "type": "string",
      "description": "Subject topic for the course deck"
    },
    "level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"],
      "description": "Target audience skill level"
    },
    "minutes": {
      "type": "integer",
      "minimum": 15,
      "maximum": 480,
      "description": "Estimated duration of the course presentation in minutes"
    },
    "stack": {
      "type": "object",
      "description": "Technologies and framework versions targeted by this deck",
      "additionalProperties": {
        "type": "string"
      }
    },
    "slides": {
      "type": "array",
      "description": "Ordered collection of presentation slides",
      "items": {
        "type": "object",
        "required": ["id", "type", "title", "bullets", "notes"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable slide identifier, e.g. s_001"
          },
          "type": {
            "type": "string",
            "enum": ["title", "overview", "code", "concept", "exercise", "summary"],
            "description": "Type layout of the slide"
          },
          "title": {
            "type": "string",
            "description": "Title of the slide"
          },
          "bullets": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            },
            "description": "Key teaching bullet points (capped at ~5 items, ~12 words each)"
          },
          "code": {
            "type": "array",
            "description": "Code snippets attached to the slide (capped at ~14 lines)",
            "items": {
              "type": "object",
              "required": ["id", "lang", "version", "kind", "source", "verified", "attempts"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Stable code snippet identifier, e.g. c_001"
                },
                "lang": {
                  "type": "string",
                  "enum": ["java", "python", "typescript", "javascript", "bash"],
                  "description": "Programming language"
                },
                "version": {
                  "type": "string",
                  "description": "Language or runtime version, e.g. 21, 3.12"
                },
                "kind": {
                  "type": "string",
                  "enum": ["spring-fragment", "class", "python-script", "function", "bash-script"],
                  "description": "Structural role of code snippet in execution"
                },
                "source": {
                  "type": "string",
                  "description": "Source code text (max ~14 lines recommended)"
                },
                "expected_output": {
                  "type": ["string", "null"],
                  "description": "Optional expected standard output pattern"
                },
                "verified": {
                  "type": "string",
                  "enum": ["passed", "failed", "unverified"],
                  "description": "Verification status: only passed snippets reach verified decks"
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Number of self-heal execution attempts needed"
                },
                "error_message": {
                  "type": ["string", "null"],
                  "description": "Compiler or runtime error message if verification failed"
                }
              }
            }
          },
          "diagram": {
            "type": ["string", "null"],
            "description": "Mermaid diagram code or visual description"
          },
          "notes": {
            "type": "string",
            "description": "Trainer speaking notes for delivery"
          }
        }
      }
    },
    "exercises": {
      "type": "array",
      "description": "Hands-on exercises proved with unit tests",
      "items": {
        "type": "object",
        "required": ["id", "starter", "tests", "reference", "naive", "proof"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable exercise identifier, e.g. e_001"
          },
          "title": {
            "type": "string",
            "description": "Exercise title"
          },
          "description": {
            "type": "string",
            "description": "Student instructions for the exercise"
          },
          "starter": {
            "type": "string",
            "description": "Boilerplate code handed to the student"
          },
          "tests": {
            "type": "string",
            "description": "Test suite to validate student solution"
          },
          "reference": {
            "type": "string",
            "description": "Official instructor reference solution (must pass tests)"
          },
          "naive": {
            "type": "string",
            "description": "Flawed/naive student solution (must fail tests)"
          },
          "proof": {
            "type": "object",
            "required": ["reference_passes", "naive_fails"],
            "properties": {
              "reference_passes": {
                "type": "boolean",
                "description": "Must be true (reference passes all tests)"
              },
              "naive_fails": {
                "type": "boolean",
                "description": "Must be true (tests must bite on buggy/incomplete code)"
              }
            }
          }
        }
      }
    },
    "quiz": {
      "type": "array",
      "description": "Assessment questions for knowledge checks",
      "items": {
        "type": "object",
        "required": ["question", "options", "answer", "explanation"],
        "properties": {
          "question": {"type": "string"},
          "options": {
            "type": "array",
            "items": {"type": "string"}
          },
          "answer": {"type": "integer"},
          "explanation": {"type": "string"}
        }
      }
    },
    "cheat_sheet": {
      "type": "string",
      "description": "Markdown formatted quick reference summary sheet"
    }
  }
}
