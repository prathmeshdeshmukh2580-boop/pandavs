# Claude API access (optional for live generation, offline fallback provided)
ANTHROPIC_API_KEY=

# Model used for generation and fixes
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Per-container / sandbox time limit in seconds
SANDBOX_TIMEOUT_SEC=60

# Per-container memory cap in MB
SANDBOX_MEMORY_MB=512

# Self-heal retries before marking unverified
MAX_FIX_ATTEMPTS=3

# Directory for decks, caches, and reports
DATA_DIR=data

# Where the UI calls the API
NEXT_PUBLIC_API_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0
