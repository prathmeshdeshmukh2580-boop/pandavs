# Copy to .env and fill in. Never commit .env.

# Claude access
ANTHROPIC_API_KEY=
# Model used for planning, generation and self-heal fixes (e.g. a current Claude model id)
CLAUDE_MODEL=

# Sandbox limits
SANDBOX_TIMEOUT_SEC=60
SANDBOX_MEMORY_MB=512
MAX_FIX_ATTEMPTS=3

# Where decks, caches and reports are stored
DATA_DIR=./data

# UI -> API
NEXT_PUBLIC_API_URL=http://localhost:8000
